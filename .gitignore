# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Environment ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- Large data ---
# Ephemerides, kernels, and datasets are fetched, not committed. Record the
# source and retrieval date in ATTRIBUTIONS.md.
/data/cache/
*.bsp
*.bpc
*.tpc

# --- Node / toolchain ---
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# Benchmark results, written by `pnpm bench` and read by `pnpm bench:check`.
# The committed baseline is tools/bench/baseline.json; these are one run of it.
tools/bench/.results/

# Python — the offline reference-fixture generator in tools/reference/.
# The generator, its lockfile and the fixture it writes are committed; the
# environment it runs in is not.
.venv/
__pycache__/
*.py[cod]
