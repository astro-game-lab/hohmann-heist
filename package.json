{
  "name": "hohmann-heist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Steal things in orbit. A browser puzzle game where the only weapon is real orbital mechanics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astro-game-lab/hohmann-heist.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hh/web dev",
    "build": "pnpm --filter @hh/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/render/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "layering": "depcruise packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project packages",
    "test:watch": "vitest --project packages",
    "test:web": "vitest run --project web",
    "test:guardrails": "vitest run --project guardrails",
    "bench": "vitest run --project bench",
    "bench:check": "node tools/bench/compare.mjs",
    "bench:report": "node tools/bench/compare.mjs --report",
    "bench:baseline": "node tools/bench/compare.mjs --write",
    "goldens:write": "node tools/goldens/generate.mjs",
    "reference:write": "uv run --project tools/reference tools/reference/generate.py",
    "goldens:doc-gate": "node tools/goldens/physics-doc-gate.mjs",
    "schema:write": "node tools/schema/generate.mjs",
    "schema:check": "node tools/schema/generate.mjs --check",
    "coastlines:write": "node tools/coastlines/process.mjs",
    "pars:write": "node tools/pars/write.mjs",
    "pars:check": "vitest run --project pars",
    "test:all": "vitest run --project !pars",
    "coverage": "vitest run --project !bench --coverage",
    "size": "size-limit",
    "size:report": "node tools/size/report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hh/astro": "workspace:*",
    "@hh/game": "workspace:*",
    "@hh/math": "workspace:*",
    "@hh/propagation": "workspace:*",
    "@hh/render": "workspace:*",
    "@hh/sim": "workspace:*",
    "@hh/ui": "workspace:*",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
