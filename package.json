{
  "name": "hohmann-heist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Steal things in orbit. A browser puzzle game where the only weapon is real orbital mechanics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astro-game-lab/hohmann-heist.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @hh/web dev",
    "build": "pnpm --filter @hh/web build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "layering": "depcruise packages apps",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project packages",
    "test:watch": "vitest --project packages",
    "test:web": "vitest run --project web",
    "test:guardrails": "vitest run --project guardrails",
    "test:all": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
