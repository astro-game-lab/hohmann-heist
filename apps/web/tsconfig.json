{
  "extends": "../../tsconfig.dom.json",
  "compilerOptions": {
    // `vite/client` for `import.meta.env`, which `app.tsx` reads to decide the
    // catalogue's missing-key policy. `node` is listed explicitly because naming
    // `types` at all turns off the automatic inclusion of every `@types` package.
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
