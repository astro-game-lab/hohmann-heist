{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.browser.json",
  "compilerOptions": {
    // The browser *and* Preact. Split from `tsconfig.browser.json` because
    // `@hh/render` needs the DOM and must never contain Preact (§11.2) — pointing
    // it at this file would hand it a JSX runtime it is not allowed to use, and
    // duplicating the `lib` list instead would leave two of them to drift apart.
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
